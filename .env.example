# ── Brokole storefront (Vite) ───────────────────────────────────────────────
# Copy this file to .env.local and fill in your project's values.
#
# Vite only exposes variables prefixed with VITE_. Supabase's docs show
# NEXT_PUBLIC_ because they assume Next.js — that prefix does nothing here.

VITE_SUPABASE_URL=https://YOUR-REF.supabase.co

# Settings -> API Keys -> Publishable key. Safe in the browser: Row Level
# Security decides what any signed-in user can reach.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Older projects show an "anon / public" JWT instead. Either name works —
# use one or the other, not both.
# VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ── Never put these in this file ────────────────────────────────────────────
# sb_secret_... / service_role bypasses Row Level Security completely, and a
# Vite build compiles anything reachable here into the JavaScript bundle that
# every visitor downloads. Secret keys belong in Edge Functions, where Supabase
# injects them for you. The app refuses to start if it finds one.
